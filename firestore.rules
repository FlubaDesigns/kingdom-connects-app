rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      let user = isAuthenticated() ? getUserData() : {};
      return isAuthenticated() &&
        (user.get('role', '') == roleName || user.get('roles', []).hasAny([roleName]));
    }
    function accountEnabled() {
      return isAuthenticated() && !(getUserData().get('account_status', 'pending') in ['suspended', 'disabled', 'rejected']);
    }
    function churchActive(churchId) {
      return churchId != null && get(/databases/$(database)/documents/churches/$(churchId)).data.listing_status == 'active';
    }
    function managesChurch(churchId) {
      return accountEnabled() && churchActive(churchId) &&
        get(/databases/$(database)/documents/churches/$(churchId)).data.admin_uid == request.auth.uid;
    }
    function managesBusiness(businessId) {
      let business = get(/databases/$(database)/documents/business_listings_public/$(businessId)).data;
      return managesChurch(business.get('church_id', null));
    }
    function reviewsBusiness(businessId) {
      let pending = get(/databases/$(database)/documents/business_affiliation_requests/$(businessId)).data;
      return pending.status == 'pending' && managesChurch(pending.church_id);
    }
    function mayEditBusiness(businessId) {
      let business = get(/databases/$(database)/documents/business_listings_public/$(businessId)).data;
      return accountEnabled() && isOwnerOfBusiness(businessId) &&
        !(business.listing_status in ['suspended', 'rejected']) &&
        (business.get('church_id', null) == null || churchActive(business.church_id));
    }

    function isAdmin() {
      return accountEnabled() && (hasRole('admin') || hasRole('platform_admin'));
    }

    function isSalesAgent() {
      return isAuthenticated() && (hasRole('sales_agent') || hasRole('sales_director') || hasRole('marketing_manager') || isAdmin());
    }

    function isChurchAdmin() {
      return isAuthenticated() && (hasRole('church_admin') || isAdmin());
    }

    function isBusinessOwner() {
      return isAuthenticated() && (hasRole('business_owner') || isAdmin());
    }

    function isOwnerOfBusiness(businessId) {
      let privateBiz = get(/databases/$(database)/documents/business_listings_private/$(businessId)).data;
      return isAuthenticated() && privateBiz.owner_uid == request.auth.uid;
    }

    function isOwnerOfChurch(churchId) {
      let church = get(/databases/$(database)/documents/churches/$(churchId)).data;
      return accountEnabled() && church.admin_uid == request.auth.uid && !(church.listing_status in ['suspended', 'rejected']);
    }

    function businessPro(businessId) {
      let b = get(/databases/$(database)/documents/business_listings_public/$(businessId)).data;
      return b.get('pro_status', null) in [true, 'pro', 'active'] &&
        (b.get('promotional_grant', false) == true || b.get('stripe_subscription_id', null) == null ||
         !('subscription_status' in b) || b.subscription_status in ['active', 'trialing']);
    }
    function mayManageProBusiness(businessId) {
      let b = get(/databases/$(database)/documents/business_listings_public/$(businessId)).data;
      let user = getUserData();
      return businessPro(businessId) && (b.get('promotional_grant', false) == true || b.get('stripe_subscription_id', null) == null ||
        (('subscription_status' in b) ? b.subscription_status in ['active', 'trialing'] :
         (user.get('stripeSubscriptionId', null) == b.stripe_subscription_id && user.get('subscription_status', '') in ['active', 'trialing'])));
    }
    function businessProfileFields() {
      return ['business_name','description','primary_category','subcategories','secondary_categories','country',
        'email','phone_number','website_url','address_line1','address_line2','city','state','zip_code',
        'logo','logo_url','hours_of_operation','photos','videos','video_files','social_media','show_social_media',
        'allow_reviews','allow_social_sharing','allow_review_sharing','show_phone','show_email','show_address','show_website','updated_at'];
    }
    function businessProfileValid(data) {
      return isValidString(data.business_name, 2, 200) && isValidString(data.get('description',''), 0, 10000)
        && data.get('photos',[]) is list && data.get('photos',[]).size() <= 10
        && data.get('videos',[]) is list && data.get('video_files',[]) is list
        && data.get('videos',[]).size() + data.get('video_files',[]).size() <= 3
        && data.get('subcategories',[]) is list && data.get('subcategories',[]).size() <= 3
        && data.get('secondary_categories',[]) is list && data.get('secondary_categories',[]).size() <= 3;
    }
    function publishedBusiness(businessId) {
      let business = get(/databases/$(database)/documents/business_listings_public/$(businessId)).data;
      return business.get('is_visible', false) == true && business.listing_status == 'active' && churchActive(business.get('church_id', null));
    }

    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function isValidEmail(email) {
      return email is string && email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    function isValidPhone(phone) {
      return phone == null || phone == '' || (phone is string && phone.size() <= 20);
    }

    function isValidUrl(url) {
      return url == null || url == '' || (url is string && (url.matches('^https?://.*') || url.size() == 0));
    }

    function churchProfileFields() { return ['church_name', 'denomination', 'description', 'welcome_message', 'hero_media_url', 'livestream_url', 'address_line1', 'address_line2', 'city', 'state', 'zip_code', 'country', 'contact_phone', 'contact_email', 'website', 'service_times', 'parishioner_count', 'directory_link', 'updated_at', 'show_social_media', 'social_media', 'allow_reviews_for_church', 'allow_social_sharing', 'allow_review_sharing', 'profile_image_url', 'profile_image_path', 'payout_method', 'page_settings', 'auto_approve_businesses', 'membership_approval_mode', 'last_page_update']; }
    function approvedChurchMember(churchId) {
      return accountEnabled() && getUserData().get('home_church_id', '') == churchId &&
        getUserData().get('church_membership_status', '') == 'approved';
    }

    // Prevent changing protected fields
    function notChanging(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;

      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'display_name', 'email', 'role', 'roles',
          'account_status', 'church_membership_status', 'created_at', 'last_login', 'is_demo', 'business_name', 'business_phone'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('role', 'member') in ['member', 'business_owner', 'church_admin']
        && request.resource.data.get('roles', ['member']).size() > 0
        && request.resource.data.get('roles', ['member']).hasOnly(['member', 'business_owner', 'church_admin'])
        && request.resource.data.get('account_status', 'pending') == 'pending'
        && request.resource.data.get('church_membership_status', 'pending') == 'pending';
      allow update: if isAdmin() || (accountEnabled() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'display_name', 'phone_number', 'profile_photo_url', 'allow_review_sharing',
          'notifications_enabled', 'last_login', 'updated_at', 'business_name', 'business_phone']));

      allow delete: if isAdmin();
    }

    // ========================================
    // BUSINESS LISTINGS PUBLIC
    // Public-facing data for directory and detail pages
    // ========================================
    match /business_listings_public/{businessId} {
      // Anyone can read visible listings, owners can read their own, admins can read all
      allow read: if isAdmin() || managesChurch(resource.data.get('church_id', null)) ||
        resource.data.get('is_visible', false) == true || isOwnerOfBusiness(businessId) || reviewsBusiness(businessId);

      // Authenticated users can create new submissions (pending, not visible)
      allow create: if accountEnabled()
                    && businessProfileValid(request.resource.data)
                    && request.resource.data.keys().hasOnly(businessProfileFields().concat(['created_by_uid','church_id','referring_church_id','platform_approved','church_approved','listing_status','is_visible','subscription_tier','pro_status','is_pro','promotional_grant','stripe_subscription_id','stripe_customer_id','created_at','is_demo']))
                    && request.resource.data.get('photos',[]).size() == 0 && request.resource.data.get('videos',[]).size() == 0 && request.resource.data.get('video_files',[]).size() == 0
                    && request.resource.data.get('subcategories',[]).size() <= 1 && request.resource.data.get('secondary_categories',[]).size() <= 1
                    && request.resource.data.get('social_media',{}) == {}
                    && request.resource.data.listing_status == 'pending'
                    && request.resource.data.is_visible == false
                    && request.resource.data.created_by_uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/business_listings_private/$(businessId)).data.owner_uid == request.auth.uid
                    && request.resource.data.get('church_id', null) == null
                    && request.resource.data.get('referring_church_id', null) == null
                    && request.resource.data.get('platform_approved', false) == false
                    && request.resource.data.get('church_approved', false) == false
                    && request.resource.data.get('is_pro', false) == false
                    && request.resource.data.get('pro_status', null) == null
                    && request.resource.data.get('subscription_tier', 'free') == 'free'
                    && request.resource.data.get('promotional_grant', false) == false
                    && request.resource.data.get('stripe_subscription_id', null) == null
                    && request.resource.data.get('stripe_customer_id', null) == null;

      // The profile editor cannot write billing, moderation, ratings, metrics or unknown fields.
      allow update: if isAdmin() || (mayEditBusiness(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(businessProfileFields())
        && businessProfileValid(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos','videos','video_files','social_media','show_social_media']) || mayManageProBusiness(businessId))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subcategories','secondary_categories']) ||
          (request.resource.data.get('subcategories',[]).size() <= 1 && request.resource.data.get('secondary_categories',[]).size() <= 1) || mayManageProBusiness(businessId)));
      allow delete: if isAdmin();

      // Pro features subcollections - owners with Pro status can manage
      match /promotions/{promotionId} {
        allow read: if (publishedBusiness(businessId) && businessPro(businessId)) || isAdmin() || isOwnerOfBusiness(businessId) || managesBusiness(businessId);
        allow write: if isAdmin() || (mayEditBusiness(businessId) && mayManageProBusiness(businessId));
      }

      match /products_services/{productId} {
        allow read: if (publishedBusiness(businessId) && businessPro(businessId) && resource.data.get('is_active', false) == true) || isAdmin() || isOwnerOfBusiness(businessId) || managesBusiness(businessId);
        allow write: if isAdmin() || (mayEditBusiness(businessId) && mayManageProBusiness(businessId));
      }

      match /testimonials/{testimonialId} {
        allow read: if (publishedBusiness(businessId) && businessPro(businessId) && resource.data.get('is_active', false) == true) || isAdmin() || isOwnerOfBusiness(businessId) || managesBusiness(businessId);
        allow write: if isAdmin() || (mayEditBusiness(businessId) && mayManageProBusiness(businessId));
      }
    }

    // ========================================
    // BUSINESS LISTINGS PRIVATE
    // Sensitive owner/billing data - owner and admin only
    // ========================================
    match /business_listings_private/{businessId} {
      // Only owner or admin can read
      allow read: if isAdmin() ||
                    (isAuthenticated() && resource.data.owner_uid == request.auth.uid);

      // Authenticated users can create (for submissions), must set owner_uid to self
      allow create: if accountEnabled()
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['owner_uid','owner_email','your_name','phone_ext','billing_cycle','trial_status','submission_date','created_at','is_demo'])
                    && request.resource.data.get('billing_cycle',null) in [null,'monthly','annual']
                    && request.resource.data.get('trial_status',null) in [null,'pending_approval']
                    && getAfter(/databases/$(database)/documents/business_listings_public/$(businessId)).data.created_by_uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/business_listings_public/$(businessId)).data.listing_status == 'pending';

      allow update: if isAdmin() || (mayEditBusiness(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['your_name','phone_ext','owner_email','updated_at']));
      allow delete: if isAdmin();

      // Commissions subcollection - admin/sales only
      match /commissions/{commissionId} {
        allow read: if isAdmin() || isSalesAgent();
        allow write: if isAdmin();
      }
    }

    // ========================================
    // CHURCHES
    // ========================================
    match /churches/{churchId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.admin_uid == request.auth.uid) || resource.data.listing_status == 'active';

      allow create: if accountEnabled()
                    && isValidString(request.resource.data.church_name, 2, 200)
                    && isValidEmail(request.resource.data.contact_email)
                    && request.resource.data.listing_status in ['pending', 'draft']
                    && request.resource.data.admin_uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(churchProfileFields().concat(['admin_uid','listing_status','created_at','submission_date','submission_type','representative_name','representative_title','submitter_email','is_demo']));

      allow update: if isAdmin() || (
                      isOwnerOfChurch(churchId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(churchProfileFields())
                    );

      allow delete: if isAdmin();

      // Church subcollections
      match /announcements/{announcementId} {
        allow read: if isAdmin() || managesChurch(churchId) || (churchActive(churchId) && resource.data.status == 'published');
        allow write: if isAdmin() || managesChurch(churchId);
      }

      match /events/{eventId} {
        allow read: if isAdmin() || managesChurch(churchId) || (churchActive(churchId) && resource.data.visibility == 'visible');
        allow write: if isAdmin() || managesChurch(churchId);
      }

      match /activities/{activityId} {
        allow read: if isAdmin() || managesChurch(churchId) || (churchActive(churchId) && resource.data.get('active', false) == true);
        allow write: if isAdmin() || managesChurch(churchId);
      }

      match /media/{mediaId} {
        allow read: if isAdmin() || managesChurch(churchId) || (churchActive(churchId) && resource.data.get('visibility', '') == 'visible');
        allow write: if isAdmin() || managesChurch(churchId);
      }

      match /resources/{resourceId} {
        allow read: if isAdmin() || managesChurch(churchId) || (churchActive(churchId) && resource.data.get('visibility', '') == 'visible');
        allow write: if isAdmin() || managesChurch(churchId);
      }
    }

    // ========================================
    // CHURCH SUBMISSIONS (DEPRECATED)
    // ========================================
    match /church_submissions/{submissionId} {
      allow read: if isAdmin() ||
                     (isAuthenticated() && resource.data.submitter_uid == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================
    // REVIEWS - Stricter validation
    // ========================================
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved'
                  || (isAuthenticated() && resource.data.user_id == request.auth.uid)
                  || isAdmin();

      // Authenticated member review changes use the backend ownership and moderation checks.
      allow create: if false;

      allow update: if isAdmin() || (resource.data.status == 'approved' && mayEditBusiness(resource.data.business_id) && mayManageProBusiness(resource.data.business_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response_text', 'response_date'])
        && isValidString(request.resource.data.response_text, 1, 500)
        && request.resource.data.response_date == request.time);
      allow delete: if isAdmin();
    }

    // ========================================
    // CATEGORIES
    // ========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // CATEGORY SUGGESTIONS
    // ========================================
    match /category_suggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
                    && isValidString(request.resource.data.suggestion, 2, 100);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================
    // ACTIVITY LOG (Immutable audit trail)
    // ========================================
    match /activity_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ========================================
    // UPLOAD TESTS (Admin diagnostic tool)
    // ========================================
    match /upload_tests/{testId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========================================
    // PAYMENTS & COMMISSIONS (Admin-controlled)
    // ========================================
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
                     (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    match /commission_policies/{policyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /commission_ledger/{ledgerId} {
      allow read: if isAdmin() || isSalesAgent();
      allow write: if false;
    }

    match /commission_balances/{balanceId} {
      allow read: if isAdmin() ||
                     (isSalesAgent() && resource.data.agent_uid == request.auth.uid);
      allow write: if false;
    }

    // ========================================
    // TITHES (System-generated from Stripe webhook)
    // ========================================
    match /tithes/{titheId} {
      allow read: if isAdmin() ||
                     (isChurchAdmin() && resource.data.church_id != null && isOwnerOfChurch(resource.data.church_id));
      allow write: if false;
    }

    // ========================================
    // CHURCH AFFILIATION REQUESTS
    // ========================================
    match /business_affiliation_requests/{businessId} {
      allow read: if isAdmin() ||
        (accountEnabled() && resource.data.requested_by_uid == request.auth.uid) ||
        managesChurch(resource.data.church_id);
      // All transitions use the authenticated, transactional hierarchy API.
      allow write: if false;
    }

    // ========================================
    // ANALYTICS (System-generated only)
    // ========================================
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========================================
    // FACTOIDS
    // ========================================
    match /factoids/{factoidId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // TESTIMONIALS (Platform-level)
    // ========================================
    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated()
                    && isValidString(request.resource.data.content, 10, 1000)
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================
    // EMAIL CAMPAIGNS (Admin only)
    // ========================================
    match /email_campaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========================================
    // FAVORITE BUSINESSES
    // ========================================
    match /favorite_businesses/{favoriteId} {
      allow list, get: if accountEnabled() && resource.data.user_id == request.auth.uid;
      allow create: if accountEnabled() && getUserData().account_status == 'active'
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.business_id is string;
      allow delete: if accountEnabled() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    // ========================================
    // DONATION REQUESTS & DONATIONS
    // ========================================
    match /donation_requests/{donationId} {
      allow read: if isAdmin();
      allow create: if isValidEmail(request.resource.data.email)
                    && isValidString(request.resource.data.reason, 10, 2000);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========================================
    // PLATFORM SETTINGS
    // ========================================
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // PRICING SETTINGS
    // ========================================
    match /pricing_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // CHURCH ACTIVITIES (Top-level)
    // ========================================
    match /church_activities/{activityId} {
      allow read: if isAdmin() || managesChurch(resource.data.church_id) ||
        (churchActive(resource.data.church_id) && resource.data.active == true);
      allow create: if isAdmin() || managesChurch(request.resource.data.church_id);
      allow update: if (isAdmin() || managesChurch(resource.data.church_id)) && notChanging('church_id');
      allow delete: if isAdmin() || managesChurch(resource.data.church_id);
    }

    // ========================================
    // CHURCH MESSAGES
    // ========================================
    match /church_messages/{messageId} {
      allow read: if isAdmin() || managesChurch(resource.data.church_id) ||
        (churchActive(resource.data.church_id) && resource.data.active == true && (resource.data.audience in ['both','social'] || (resource.data.audience == 'members' && approvedChurchMember(resource.data.church_id))));
      allow create: if isAdmin() || managesChurch(request.resource.data.church_id);
      allow update: if (isAdmin() || managesChurch(resource.data.church_id)) && notChanging('church_id');
      allow delete: if isAdmin() || managesChurch(resource.data.church_id);
    }

    // ========================================
    // QUESTIONNAIRE QUESTIONS
    // ========================================
    match /questionnaire_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ========================================
    // CHURCH INSIGHTS
    // ========================================
    match /business_insights/{businessId} {
      allow read: if isAdmin() || mayEditBusiness(businessId);
      allow create, update: if (isAdmin() || mayEditBusiness(businessId))
        && request.resource.data.business_id == businessId
        && request.resource.data.keys().hasOnly(['business_id', 'answers', 'completed', 'created_at', 'updated_at']);
      allow delete: if isAdmin();
    }

    match /church_insights/{churchId} {
      allow read: if isAdmin() || managesChurch(churchId);
      allow create: if (isAdmin() || managesChurch(churchId)) && request.resource.data.church_id == churchId;
      allow update: if (isAdmin() || managesChurch(churchId)) && request.resource.data.church_id == churchId && notChanging('church_id');
      allow delete: if isAdmin();
    }

    // ========================================
    // SALES APPLICATIONS
    // ========================================
    match /sales_applications/{applicationId} {
      allow read: if isAdmin() || hasRole('marketing_manager');
      allow create: if isValidString(request.resource.data.name, 2, 100)
                    && isValidEmail(request.resource.data.email);
      allow update: if isAdmin() || hasRole('marketing_manager');
      allow delete: if isAdmin();
    }

    // ========================================
    // KINGDOM FUND
    // ========================================
    match /kingdom_fund/{fundId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========================================
    // EMAIL TEMPLATES
    // ========================================
    match /email_templates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========================================
    // CONTACT SUBMISSIONS
    // ========================================
    match /contact_submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================
    // PRESENTATION TEMPLATES
    // ========================================
    match /presentation_templates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========================================
    // EMAIL LOGS (Immutable)
    // ========================================
    match /email_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Private platform work list. Existing canonical administrator authority applies.
    match /admin_tasks/{taskId} {
      function validTask() {
        let d = request.resource.data;
        return d.keys().hasAll(['title','notes','link','priority','status','created_at','updated_at','created_by'])
          && d.keys().hasOnly(['title','notes','link','priority','status','created_at','updated_at','created_by'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.notes is string && d.notes.size() <= 5000
          && d.link is string && d.link.size() <= 2000
          && (d.link == '' || d.link.matches('https://.*'))
          && d.priority in ['high','normal','low']
          && d.status in ['open','in_progress','blocked','deferred','done','archived']
          && d.created_at is timestamp && d.updated_at is timestamp
          && d.created_by is string;
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && validTask() && request.resource.data.created_by == request.auth.uid;
      allow update: if isAdmin() && validTask()
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }

    // ========================================
    // FALLBACK - DENY ALL
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
